{
  "name": "oci-panel-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.vue",
    "lint:fix": "eslint src --ext .ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@lucide/vue": "^1.54.0",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/motion": "^3.0.3",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^4.0.3",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "overrides": {
    "radix-vue": {
      "nanoid": "^5.1.16"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "allowScripts": {
    "vue-demi": false,
    "fsevents": false
  }
}
